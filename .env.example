# Copy to .env and fill with your credentials

# Twilio (optional, WhatsApp integration)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+15550000000

# LLM provider
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Telegram bots
# PROD bot token (required for prod Telegram channel)
TELEGRAM_BOT_TOKEN=123456789:prod_bot_token_here
# LAB bot token (use a different bot/token from prod)
TELEGRAM_BOT_TOKEN_LAB=123456789:lab_bot_token_here

# Professional policy checks (optional; used by scripts/professional-check.*)
# Optional explicit policy env file consumed by professional-check scripts
OPENCLAW_POLICY_ENV_FILE=
# Allow subagents without persona inheritance ("1" to allow, default policy expects empty/off)
OPENCLAW_ALLOW_SUBAGENT_MINIMAL_PERSONA=
# Allow automatic subagent archive sweep ("1" to allow, default policy expects empty/off)
OPENCLAW_ALLOW_SUBAGENT_AUTO_ARCHIVE=
# Optional expected primary model (exact match required if set)
OPENCLAW_EXPECTED_ENGINE_PRIMARY=
# Optional expected fallback chain (comma-separated, exact order)
OPENCLAW_EXPECTED_ENGINE_FALLBACKS=
# Optional expected persona inheritance (true/false or 1/0)
OPENCLAW_EXPECT_SUBAGENT_INHERIT_PERSONA=
# Optional expected archive timeout in minutes, or "disabled"/"0"
OPENCLAW_EXPECT_SUBAGENT_ARCHIVE_AFTER_MINUTES=
# Optional expected gateway bind (auto|lan|loopback|custom|tailnet)
OPENCLAW_EXPECTED_GATEWAY_BIND=
# Optional expected sandbox mode (off|non-main|all or "unset")
OPENCLAW_EXPECTED_SANDBOX_MODE=
# Optional expected exec approval mode (off|on-miss|always)
OPENCLAW_EXPECTED_EXEC_ASK=
# Optional expected heartbeat interval string (e.g. "30m")
OPENCLAW_EXPECTED_HEARTBEAT_EVERY=
# Optional expected heartbeat active-hours state (true/false)
OPENCLAW_EXPECT_HEARTBEAT_ACTIVE_HOURS=
# Optional cron store override used by policy checks
OPENCLAW_CRON_STORE=
# Allow non-loopback/non-tailnet gateway bind in policy check ("1" to allow)
OPENCLAW_ALLOW_NON_LOOPBACK_GATEWAY=
# Allow sandbox off/unset in policy check ("1" to allow)
OPENCLAW_ALLOW_SANDBOX_OFF=
# Allow exec ask off in policy check ("1" to allow)
OPENCLAW_ALLOW_EXEC_ASK_OFF=
# Allow heartbeat without complete activeHours in policy check ("1" to allow)
OPENCLAW_ALLOW_NO_HEARTBEAT_ACTIVE_HOURS=
# Allow fully disabling heartbeat schedule in policy check ("1" to allow)
OPENCLAW_ALLOW_HEARTBEAT_DISABLED=
# Allow main-session cron jobs in policy check ("1" to allow)
OPENCLAW_ALLOW_MAIN_CRON_JOBS=
# Require all enabled cron jobs to avoid main-session target ("1" to enforce)
OPENCLAW_REQUIRE_ISOLATED_CRON=
