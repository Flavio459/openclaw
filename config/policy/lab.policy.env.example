# OpenClaw policy baseline - LAB
# Copy to: ~/.openclaw/policy.env (or set OPENCLAW_POLICY_ENV_FILE to this file)

# Pin model routing (exact match + order)
OPENCLAW_EXPECTED_ENGINE_PRIMARY=google-antigravity/claude-opus-4-6-thinking
OPENCLAW_EXPECTED_ENGINE_FALLBACKS=google-antigravity/gemini-3-pro-high,openrouter/moonshotai/kimi-k2.5,openrouter/deepseek/deepseek-r1

# Session/persona durability
OPENCLAW_EXPECT_SUBAGENT_INHERIT_PERSONA=true
OPENCLAW_EXPECT_SUBAGENT_ARCHIVE_AFTER_MINUTES=disabled

# Security defaults for lab (still safe by default)
OPENCLAW_EXPECTED_GATEWAY_BIND=loopback
OPENCLAW_EXPECTED_EXEC_ASK=on-miss

# Lab flexibility toggles
OPENCLAW_ALLOW_SANDBOX_OFF=1
OPENCLAW_ALLOW_HEARTBEAT_DISABLED=1
OPENCLAW_ALLOW_NO_HEARTBEAT_ACTIVE_HOURS=1
OPENCLAW_ALLOW_MAIN_CRON_JOBS=1

# Keep dangerous relaxations off unless explicitly needed
OPENCLAW_ALLOW_NON_LOOPBACK_GATEWAY=
OPENCLAW_ALLOW_EXEC_ASK_OFF=
OPENCLAW_ALLOW_SUBAGENT_MINIMAL_PERSONA=
OPENCLAW_ALLOW_SUBAGENT_AUTO_ARCHIVE=
